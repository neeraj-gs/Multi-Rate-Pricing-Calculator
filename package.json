    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "jose": "^5.9.6",
    "lucide-react": "^0.469.0",
    "mongoose": "^8.9.3",
    "next": "^15.5.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "sonner": "^1.7.1",
    "swr": "^2.2.5",
    "tailwind-merge": "^2.6.0",
    "three": "^0.180.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
