{
  "name": "ledgerline",
  "version": "1.0.0",
  "private": true,
  "description": "LedgerLine - multi-rate pricing calculator for quotes, proposals and billing documents.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:local": "tsx scripts/dev-db.ts",
    "seed": "tsx scripts/seed.ts",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
