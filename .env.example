# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# MongoDB connection string.
#   Local:  mongodb://127.0.0.1:27017/ledgerline
#   Atlas:  mongodb+srv://USER:PASSWORD@cluster.mongodb.net/ledgerline?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ledgerline

# Signing key for session JWTs. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=replace-me-with-at-least-32-random-characters

# Public origin, used to build share links. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
